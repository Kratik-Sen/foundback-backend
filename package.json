{
  "name": "campusfind-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "node --watch local.js",
    "start": "node local.js",
    "seed": "node seed/index.js",
    "samples:sync": "node scripts/syncSampleItems.js",
    "dashboard-history:sync": "node scripts/syncDashboardHistory.js",
    "migrate:auto-approve": "node scripts/autoApproveListings.js --apply",
    "migrate:direct-chats": "node scripts/prepareDirectChats.js",
    "migrate:complaint-notifications": "node scripts/backfillComplaintNotifications.js",
